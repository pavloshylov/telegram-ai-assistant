# Token from @BotFather
BOT_TOKEN=123456:replace-me

# Which business the assistant serves: realty (Northwind Homes) or shop (Northwind Audio)
VERTICAL=realty

# demo = offline, pre-written replies for the sample questions (no API key needed)
# gemini = live model through the Gemini API
LLM_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: used when the main model answers 503 ("high demand") or times out, e.g. gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=
GEMINI_TIMEOUT_S=30

# LLM_PROVIDER=ollama: a local model through Ollama (https://ollama.com), no API key, no cloud.
# Pull a model first, e.g. `ollama pull qwen2.5:3b-instruct`. Small models are slow on modest hardware.
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=4096
OLLAMA_TIMEOUT_S=600

# USD per 1M tokens, used by the /admin cost report (see docs/COSTS.md)
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50

# Telegram user IDs that receive leads and can use /admin
ADMIN_IDS=111111111

# SQLite by default; PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///data/assistant.db

# Max questions per user per hour (protects the API budget)
RATE_LIMIT_PER_HOUR=30

# --- Website chat widget (python -m app.web), see docs/WIDGET.md; BOT_TOKEN is optional there
# Sites allowed to embed the widget, comma-separated (empty = only this server's own pages)
WIDGET_ALLOWED_ORIGINS=
# Enables /api/admin/stats and /api/admin/leads.csv (header X-Admin-Key); empty = admin API off
ADMIN_API_KEY=
# Per client IP, on top of RATE_LIMIT_PER_HOUR per visitor
IP_RATE_LIMIT_PER_HOUR=120

# --- WhatsApp channel (python -m app.whatsapp), see docs/WHATSAPP.md; BOT_TOKEN + ADMIN_IDS are optional there (lead alerts)
# Access token (temporary on Meta's test number), id of the sending phone number (not the number itself)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; the same value goes into App Dashboard > WhatsApp > Webhooks > Verify token
WHATSAPP_VERIFY_TOKEN=
# App Dashboard > App settings > Basic > App secret: used to check the signature of every webhook POST
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v27.0
# WHATSAPP_SHOW_SOURCES=false   # true: keep [n] markers and a "Sources" line in WhatsApp replies
